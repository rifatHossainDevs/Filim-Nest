<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/img_9"
    android:gravity="center"
    android:orientation="vertical"
    tools:context=".presentation.signup.SignUpFragment">

    <ImageView
        app:layout_constraintVertical_bias=".2"
        android:layout_width="220dp"
        android:layout_height="@dimen/_110sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="@dimen/_16sdp"
        android:src="@drawable/filim_nest_logo2"/>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="68dp"
        android:backgroundTint="#4787F3"
        android:layout_marginHorizontal="@dimen/_16sdp">

        <LinearLayout
            android:layout_gravity="bottom"
            android:id="@+id/sign_in_with_google"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/_4sdp">

            <ImageView
                android:padding="@dimen/_4sdp"
                android:layout_width="40dp"
                android:src="@drawable/ic_google_24"
                android:background="@drawable/google_bg"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"/>

            <TextView
                android:layout_marginStart="@dimen/_16sdp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sign in with Google"
                android:textColor="@color/white"
                android:layout_gravity="center"
                android:textSize="@dimen/_20sdp"
                android:textStyle="bold"/>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>


</androidx.constraintlayout.widget.ConstraintLayout>

